{
  "manifest_version": 3,
  "name": "SweepGuard - Wallet Protection",
  "version": "1.0.0",
  "description": "Auto-sweep protection for compromised EVM wallets. Detect drainers, claim airdrops safely, and protect your funds.",
  "permissions": ["activeTab", "storage", "notifications", "alarms"],
  "host_permissions": ["https://*.vercel.app/*", "https://*.alchemy.com/*", "https://*.infura.io/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "css": ["css/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
