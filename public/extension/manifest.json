{
  "manifest_version": 3,
  "name": "SweepGuard Wallet",
  "version": "2.1.0",
  "description": "Rescue assets from compromised wallets and claim airdrops safely using EIP-7702 delegation. Fund rescue tool with sponsor wallet support.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SweepGuard Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
